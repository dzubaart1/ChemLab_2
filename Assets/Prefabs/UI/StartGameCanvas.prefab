--- !u!114 &447025045891637645
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2191280748301811790}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4cad27b1129b47eca8fc9e24f4775f6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _text: {fileID: 4238782579335946465}
  _textConfigs:
  - Language: 0
    Text: "\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
      \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u044E\u0442\u0441\u044F \u043F\u0440\u0438
      \u043F\u043E\u043C\u043E\u0449\u0438 \u043A\u043D\u043E\u043F\u043E\u043A 
      (\u043F\u043B\u0438\u0442\u043A\u0430, \u043F\u0438\u043F\u0435\u0442\u0434\u043E\u0437\u0430\u0442\u043E\u0440,
      \u0441\u0443\u0448\u0438\u043B\u044C\u043D\u044B\u0439 \u0448\u043A\u0430\u0444).
      \u0414\u043B\u044F \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438 
      \u044D\u0442\u0438\u0445 \u043A\u043D\u043E\u043F\u043E\u043A \u043D\u0430\u0432\u0435\u0434\u0438\u0442\u0435
      \u0440\u0443\u043A\u0443 \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443
      \u0434\u043E \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F \u0431\u0435\u043B\u043E\u0433\u043E
      \u043B\u0443\u0447\u0430 \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043D\u0430 \u0442\u0440\u0438\u0433\u0433\u0435\u0440 1 \u043D\u0430 \u043F\u0440\u0430\u0432\u043E\u043C
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440\u0435.  "
  - Language: 1
    Text: Some items are activated by buttons (hotplate, pipette dispenser, drying
      cabinet). To activate these buttons, point your hand at the button until a
      white beam appears and press trigger 1 on the right controller.
