  m_GameObject: {fileID: 2191280749750696563}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4cad27b1129b47eca8fc9e24f4775f6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _text: {fileID: 1233280145349358967}
  _textConfigs:
  - Language: 0
    Text: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
      \u0432 \u0444\u0438\u043B\u0438\u0430\u043B \u041D\u0430\u0443\u0447\u043D\u043E-\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u0446\u0435\u043D\u0442\u0440\u0430 \u0438\u043D\u0444\u043E\u0445\u0438\u043C\u0438\u0438,
      \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0439
      \u043D\u0430 \u043E\u0440\u0431\u0438\u0442\u0430\u043B\u044C\u043D\u043E\u0439
      \u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u0418\u0422\u041C\u041E. \u0412\u0430\u043C
      \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u043E\u0434\u043D\u0443 \u0438\u0437 \u0434\u0432\u0443\u0445 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u044B\u0445
      \u0440\u0430\u0431\u043E\u0442. "
  - Language: 1
    Text: Welcome to the branch of the Scientific and Educational Center of Infochemistry,
      located on the ITMO orbital station. You will have to complete one of two laboratory
      assignments.
