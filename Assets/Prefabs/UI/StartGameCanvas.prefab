MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2191280750132043542}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4cad27b1129b47eca8fc9e24f4775f6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _text: {fileID: 7625579912980335796}
  _textConfigs:
  - Language: 0
    Text: "\u041D\u0430\u0434 \u043B\u0435\u0432\u043E\u0439 \u0440\u0443\u043A\u043E\u0439
      \u0443 \u0432\u0430\u0441 \u0431\u0443\u0434\u0435\u0442 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u043F\u043B\u0430\u043D\u0448\u0435\u0442 \u0441 \u0437\u0430\u0434\u0430\u043D\u0438\u044F\u043C\u0438.
      \u0427\u0442\u043E\u0431\u044B \u0441\u043A\u0440\u044B\u0442\u044C/\u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C
      \u0435\u0433\u043E, \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043A\u043D\u043E\u043F\u043A\u0443
      \u201C\u0425\u201D \u043D\u0430 \u043B\u0435\u0432\u043E\u043C \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440\u0435. "
  - Language: 1
    Text: "Above your left hand you will have a tablet with tasks. To hide/show it,
      press the \u201CX\u201D button on the left controller."
