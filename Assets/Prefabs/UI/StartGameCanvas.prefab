  m_Name: 
  m_EditorClassIdentifier: 
  _text: {fileID: 5984542567561789420}
  _textConfigs:
  - Language: 0
    Text: "\u0414\u043B\u044F \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B
      \u0445\u043E\u0434\u0438\u0442\u044C, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0434\u0436\u043E\u0439\u0441\u0442\u0438\u043A \u043D\u0430 \u043F\u0440\u0430\u0432\u043E\u043C 
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440\u0435. \u0427\u0442\u043E\u0431\u044B
      \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0442\u044C -
      \u0434\u0436\u043E\u0439\u0441\u0442\u0438\u043A  \u043D\u0430 \u043B\u0435\u0432\u043E\u043C
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440\u0435."
  - Language: 1
    Text: To walk, use the joystick on the right  controller. To turn, use the joystick
      on the left  controller.
