--- !u!114 &5875309666564570936
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2191280749298409765}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4cad27b1129b47eca8fc9e24f4775f6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _text: {fileID: 6261202640316757727}
  _textConfigs:
  - Language: 0
    Text: "\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u044B
      \u0438\u043C\u0435\u044E\u0442 \u0441\u043A\u0440\u044B\u0442\u0443\u044E \u043F\u0430\u043D\u0435\u043B\u044C,
      \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u043E \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435
      \u0432\u043D\u0443\u0442\u0440\u0438 \u043E\u0431\u044A\u0435\u043A\u0442\u0430.
      \u0427\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C/\u0441\u043A\u0440\u044B\u0442\u044C
      \u044D\u0442\u0443 \u043F\u0430\u043D\u0435\u043B\u044C, \u0432\u043E\u0437\u044C\u043C\u0438\u0442\u0435
      \u043E\u0431\u044A\u0435\u043A\u0442 \u0432 \u043F\u0440\u0430\u0432\u0443\u044E
      \u0440\u0443\u043A\u0443 \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043A\u043D\u043E\u043F\u043A\u0443 \u201C\u0410\u201D. "
  - Language: 1
    Text: "Some objects have a hidden panel, which contains information about the
      substance inside the object. To see/hide this panel, take the object in your
      right hand and press the \u201CA\u201D button."
