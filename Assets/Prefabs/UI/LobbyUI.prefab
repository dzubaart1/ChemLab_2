  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041F\u0435\u0440\u0432\u0430\u044F \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0430\u044F
    \u0440\u0430\u0431\u043E\u0442\u0430 \u043F\u043E\u0441\u0432\u044F\u0449\u0435\u043D\u0430
    \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044E \u0443\u043F\u043E\u0440\u044F\u0434\u043E\u0447\u0435\u043D\u043D\u044B\u0445
    \u043F\u0430\u0442\u0442\u0435\u0440\u043D\u043E\u0432 \u0438\u0437 \u0433\u0438\u0434\u0440\u043E\u043A\u0441\u0438\u0430\u043F\u0430\u0442\u0438\u0442\u0430.\n\n\u0412\u0442\u043E\u0440\u0443\u044E
    \u0438 \u0442\u0440\u0435\u0442\u044C\u044E \u0440\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0443\u044E
    \u0440\u0430\u0431\u043E\u0442\u0443 \u0432\u0430\u043C \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u0432 \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0439
    \u043C\u0438\u043A\u0440\u043E\u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438 (\u041C\u041C\u041B),
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0430
    \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B \u0441 \u043A\u043B\u0435\u0442\u043E\u0447\u043D\u044B\u043C\u0438
    \u0438 \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u043C\u0438
    \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0430\u043C\u0438."
