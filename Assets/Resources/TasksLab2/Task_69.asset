  LabTask:
    Lab: 1
    Number: 69
    Title: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435 69"
    TitleEnglish: 
    Description: "\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0430\u0432\u0442\u043E\u043A\u043B\u0430\u0432"
    DescriptionEnglish: 
    Warning: "\u0410\u0432\u0442\u043E\u043A\u043B\u0430\u0432 \u2014 \u044D\u0442\u043E
      \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0447\u043D\u043E\u0435 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
      \u0434\u043B\u044F \u0441\u0442\u0435\u0440\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438
      \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432
      \u043F\u043E\u0434 \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C
      \u0432\u044B\u0441\u043E\u043A\u0438\u0445 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440
      \u0438 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F. \u041E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
      \u043F\u0440\u0438\u043D\u0446\u0438\u043F \u0440\u0430\u0431\u043E\u0442\u044B
      \u0430\u0432\u0442\u043E\u043A\u043B\u0430\u0432\u0430 \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438
      \u043D\u0430\u0441\u044B\u0449\u0435\u043D\u043D\u043E\u0433\u043E \u043F\u0430\u0440\u0430
      \u043F\u043E\u0434 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C,
      \u0447\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C
      \u0432\u0441\u0435 \u0432\u0438\u0434\u044B \u043C\u0438\u043A\u0440\u043E\u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u043E\u0432,
      \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0438,
      \u0432\u0438\u0440\u0443\u0441\u044B, \u0433\u0440\u0438\u0431\u044B \u0438
      \u0441\u043F\u043E\u0440\u044B."
    WarningEnglish: 
    SafetyPrecautions: "\u2022\t\u041F\u043E\u043C\u0435\u0449\u0430\u0439\u0442\u0435
      \u0432 \u0430\u0432\u0442\u043E\u043A\u043B\u0430\u0432 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043C\u043E\u0433\u0443\u0442 \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C
      \u0432\u044B\u0441\u043E\u043A\u0438\u0435 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u044B
      \u0438 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435. \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
      \u0441\u0442\u0435\u043A\u043B\u043E \u0438 \u043C\u0435\u0442\u0430\u043B\u043B\u044B
      \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0442 \u0434\u043B\u044F \u0441\u0442\u0435\u0440\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438,
      \u0430 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043B\u0430\u0441\u0442\u0438\u043A\u0438
      \u043C\u043E\u0433\u0443\u0442 \u0434\u0435\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0438\u043B\u0438 \u0440\u0430\u0441\u043F\u043B\u0430\u0432\u0438\u0442\u044C\u0441\u044F.\r\n\u2022\t\u0420\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0439\u0442\u0435
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0432 \u0430\u0432\u0442\u043E\u043A\u043B\u0430\u0432\u0435
      \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B \u043F\u0430\u0440 \u043C\u043E\u0433
      \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E \u0446\u0438\u0440\u043A\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0432\u043E\u043A\u0440\u0443\u0433 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430. \u041D\u0435 \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0430\u0439\u0442\u0435
      \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u0438 \u043D\u0435
      \u043A\u043B\u0430\u0434\u0438\u0442\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
      \u0432\u043F\u043B\u043E\u0442\u043D\u0443\u044E \u0434\u0440\u0443\u0433 \u043A
      \u0434\u0440\u0443\u0433\u0443.\r\n\u2022\t\u0414\u0432\u0435\u0440\u044C \u0432
      \u0430\u0432\u0442\u043E\u043A\u043B\u0430\u0432 \u0434\u043E\u043B\u0436\u043D\u0430
      \u0431\u044B\u0442\u044C \u043F\u043B\u043E\u0442\u043D\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u0430\r\n\u2022\t\u041F\u043E\u0441\u043B\u0435
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044F \u0446\u0438\u043A\u043B\u0430
      \u0434\u043E\u0436\u0434\u0438\u0442\u0435\u0441\u044C \u043F\u043E\u043B\u043D\u043E\u0433\u043E
      \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044F \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F
      \u0438 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u044B \u0434\u043E
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0433\u043E \u0443\u0440\u043E\u0432\u043D\u044F,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C
      \u0434\u0432\u0435\u0440\u044C. \u0420\u0435\u0437\u043A\u043E\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0435
      \u043C\u043E\u0436\u0435\u0442 \u0432\u044B\u0437\u0432\u0430\u0442\u044C \u0432\u044B\u0431\u0440\u043E\u0441
      \u0433\u043E\u0440\u044F\u0447\u0435\u0433\u043E \u043F\u0430\u0440\u0430 \u0438
      \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043A \u043E\u0436\u043E\u0433\u0430\u043C.\r\n\u2022\t\u041D\u0430\u0434\u0435\u043D\u044C\u0442\u0435
      \u0442\u0435\u0440\u043C\u043E\u0441\u0442\u043E\u0439\u043A\u0438\u0435 \u043F\u0435\u0440\u0447\u0430\u0442\u043A\u0438
      \u043F\u0440\u0438 \u0440\u0430\u0437\u0433\u0440\u0443\u0437\u043A\u0435 \u0430\u0432\u0442\u043E\u043A\u043B\u0430\u0432\u0430,
      \u0447\u0442\u043E\u0431\u044B \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C
      \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0430 \u0441 \u0433\u043E\u0440\u044F\u0447\u0438\u043C\u0438
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u043C\u0438 \u0438\u043B\u0438
      \u043F\u0430\u0440\u043E\u043C.\r"
