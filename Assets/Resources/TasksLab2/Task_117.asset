  LabTask:
    Lab: 1
    Number: 117
    Title: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435 117"
    TitleEnglish: 
    Description: "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u043F\u0435\u043D\u0438\u0446\u0438\u043B\u043B\u0438\u043D\u043E\u0432\u044B\u0439
      \u0444\u043B\u0430\u043A\u043E\u043D \u0441 \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u044F\u043C\u0438
      \xABS.t. 56-45\xBB. \u041F\u043E\u043B\u043E\u0436\u0438\u0442\u0435 \u0435\u0433\u043E
      \u0432\u043D\u0443\u0442\u0440\u044C \u043B\u0430\u043C\u0438\u043D\u0430\u0440\u043D\u043E\u0433\u043E
      \u0431\u043E\u043A\u0441\u0430. \u041F\u043E\u043B\u043E\u0436\u0438\u0442\u0435
      \u043F\u0440\u043E\u0431\u043A\u0443 \u043E\u0442 \u0444\u043B\u0430\u043A\u043E\u043D\u0430
      \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439 \u0447\u0430\u0441\u0442\u044C\u044E
      \u0432\u0432\u0435\u0440\u0445"
    DescriptionEnglish: 
    Warning: "\u0412\u0430\u0436\u043D\u043E \u043A\u043B\u0430\u0441\u0442\u044C
      \u043F\u0440\u043E\u0431\u043A\u0443 \u043E\u0442 \u0444\u043B\u0430\u043A\u043E\u043D\u0430
      \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439 \u0447\u0430\u0441\u0442\u044C\u044E
      \u0432\u0432\u0435\u0440\u0445, \u0447\u0442\u043E\u0431\u044B \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C
      \u0437\u0430\u0433\u0440\u044F\u0437\u043D\u0435\u043D\u0438\u044F \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E
      \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0438\u0440\u0443\u0435\u0442 \u0441
      \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u044B\u043C \u0444\u043B\u0430\u043A\u043E\u043D\u0430.
      \u0415\u0441\u043B\u0438 \u043F\u0440\u043E\u0431\u043A\u0430 \u043A\u043E\u0441\u043D\u0451\u0442\u0441\u044F
      \u0432\u043D\u0435\u0448\u043D\u0438\u0445 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0435\u0439
      \u0438\u043B\u0438 \u0441\u0442\u043E\u043B\u0430 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439
      \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439, \u043D\u0430 \u043D\u0435\u0451
      \u043C\u043E\u0433\u0443\u0442 \u043F\u043E\u043F\u0430\u0441\u0442\u044C \u043C\u0438\u043A\u0440\u043E\u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u044B
      \u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u0437\u0430\u0433\u0440\u044F\u0437\u043D\u0438\u0442\u0435\u043B\u0438,
      \u0447\u0442\u043E \u043F\u0440\u0438\u0432\u0435\u0434\u0451\u0442 \u043A
      \u043A\u043E\u043D\u0442\u0430\u043C\u0438\u043D\u0430\u0446\u0438\u0438 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0433\u043E
      \u0444\u043B\u0430\u043A\u043E\u043D\u0430 \u043F\u0440\u0438 \u0435\u0433\u043E
      \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u043C \u0437\u0430\u043A\u0440\u044B\u0442\u0438\u0438"
