  LabTask:
    Lab: 1
    Number: 94
    Title: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435 94"
    TitleEnglish: 
    Description: "\u041D\u0430 \u043F\u0440\u0438\u0431\u043E\u0440\u043D\u043E\u0439
      \u043F\u0430\u043D\u0435\u043B\u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043A\u043D\u043E\u043F\u043A\u0443 \xABF\xBB, \u043F\u043E\u0441\u043B\u0435
      \u0447\u0435\u0433\u043E \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u0441\u044F
      \u043B\u0430\u043C\u0438\u043D\u0430\u0440\u043D\u044B\u0439 \u043F\u043E\u0442\u043E\u043A "
    DescriptionEnglish: 
    Warning: "\u041B\u0430\u043C\u0438\u043D\u0430\u0440\u043D\u044B\u0439 \u043F\u043E\u0442\u043E\u043A
      \u2014 \u044D\u0442\u043E \u0440\u0430\u0432\u043D\u043E\u043C\u0435\u0440\u043D\u044B\u0439,
      \u043E\u0434\u043D\u043E\u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
      \u043F\u043E\u0442\u043E\u043A \u0444\u0438\u043B\u044C\u0442\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
      \u0432\u043E\u0437\u0434\u0443\u0445\u0430 (\u043E\u0431\u044B\u0447\u043D\u043E
      \u0447\u0435\u0440\u0435\u0437 HEPA-\u0444\u0438\u043B\u044C\u0442\u0440\u044B),
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0438 \u0438\u0441\u0441\u043B\u0435\u0434\u0443\u0435\u043C\u044B\u0435
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0438 \u043D\u0435
      \u0434\u0430\u0451\u0442 \u0447\u0430\u0441\u0442\u0438\u0446\u0430\u043C \u043F\u044B\u043B\u0438,
      \u043C\u0438\u043A\u0440\u043E\u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430\u043C
      \u0438 \u0434\u0440\u0443\u0433\u0438\u043C \u0437\u0430\u0433\u0440\u044F\u0437\u043D\u0438\u0442\u0435\u043B\u044F\u043C
      \u0438\u0437 \u0432\u043D\u0435\u0448\u043D\u0435\u0439 \u0441\u0440\u0435\u0434\u044B
      \u043F\u043E\u043F\u0430\u0441\u0442\u044C \u0432 \u0440\u0430\u0431\u043E\u0447\u0435\u0435
      \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E. \u042D\u0442\u043E
      \u0432\u0430\u0436\u043D\u043E \u043F\u0440\u0438 \u0440\u0430\u0431\u043E\u0442\u0435
      \u0441 \u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u043C\u0438, \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0430\u043C\u0438
      \u043A\u043B\u0435\u0442\u043E\u043A \u0438 \u043C\u0438\u043A\u0440\u043E\u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430\u043C\u0438,
      \u0433\u0434\u0435 \u0434\u0430\u0436\u0435 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u043A\u043E\u043D\u0442\u0430\u043C\u0438\u043D\u0430\u0446\u0438\u044F \u043C\u043E\u0436\u0435\u0442
      \u0438\u0441\u043A\u0430\u0437\u0438\u0442\u044C \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B
      \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u043E\u0432.\r\n\u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435
      \u043B\u0430\u043C\u0438\u043D\u0430\u0440\u043D\u043E\u0433\u043E \u043F\u043E\u0442\u043E\u043A\u0430
      \u0432 \u043B\u0430\u043C\u0438\u043D\u0430\u0440\u043D\u043E\u043C \u0431\u043E\u043A\u0441\u0435
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0434\u043B\u044F
      \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0441\u0442\u0435\u0440\u0438\u043B\u044C\u043D\u043E\u0439
      \u0441\u0440\u0435\u0434\u044B \u0438 \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
      \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F \u0432\u043D\u0435\u0448\u043D\u0438\u0445
      \u0437\u0430\u0433\u0440\u044F\u0437\u043D\u0438\u0442\u0435\u043B\u0435\u0439
      \u0432 \u0440\u0430\u0431\u043E\u0447\u0443\u044E \u0437\u043E\u043D\u0443.
      \r\n\u041B\u0430\u043C\u0438\u043D\u0430\u0440\u043D\u044B\u0439 \u043F\u043E\u0442\u043E\u043A
      \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0432 \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
      \u043A\u043E\u043D\u0442\u0430\u043C\u0438\u043D\u0430\u0446\u0438\u0438 (\u041A\u043E\u043D\u0442\u0430\u043C\u0438\u043D\u0430\u0446\u0438\u044F
      \u2013 \u044D\u0442\u043E \u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u0437\u0430\u0433\u0440\u044F\u0437\u043D\u0435\u043D\u0438\u044F
      \u0438\u043B\u0438 \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u043A\u0430\u043A\u043E\u0433\u043E-\u043B\u0438\u0431\u043E
      \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430 \u0438\u043B\u0438 \u0441\u0440\u0435\u0434\u044B
      \u043D\u0435\u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438
      \u043F\u0440\u0438\u043C\u0435\u0441\u044F\u043C\u0438, \u043C\u0438\u043A\u0440\u043E\u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430\u043C\u0438
      \u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0432\u0440\u0435\u0434\u043D\u044B\u043C\u0438
      \u0430\u0433\u0435\u043D\u0442\u0430\u043C\u0438. \u0412 \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\u0435
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u044B\u0445 \u0438
      \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
      \u0443\u0441\u043B\u043E\u0432\u0438\u0439 \u043A\u043E\u043D\u0442\u0430\u043C\u0438\u043D\u0430\u0446\u0438\u044F
      \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438
      \u043A \u043D\u0435\u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u044B\u043C
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430\u043C \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439,
      \u043F\u043E\u0440\u0447\u0435 \u043F\u0440\u043E\u0434\u0443\u043A\u0446\u0438\u0438
      \u0438\u043B\u0438 \u0434\u0430\u0436\u0435 \u043A \u0443\u0433\u0440\u043E\u0437\u0435
      \u0434\u043B\u044F \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F.).\r\n"
