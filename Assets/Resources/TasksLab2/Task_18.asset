  LabTask:
    Lab: 1
    Number: 18
    Title: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435 18"
    TitleEnglish: 
    Description: "\u041D\u0430\u0441\u044B\u043F\u044C\u0442\u0435 \u043F\u0435\u043F\u0442\u043E\u043D
      \u0438\u0437 \u043C\u0435\u0440\u043D\u043E\u0439 \u043B\u043E\u0436\u0435\u0447\u043A\u0438
      \u0432 \u043B\u043E\u0434\u043E\u0447\u043A\u0443 \u0434\u043B\u044F \u0432\u0437\u0432\u0435\u0448\u0438\u0432\u0430\u043D\u0438\u044F.
      \u041D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u0430\u044F \u043C\u0430\u0441\u0441\u0430
      \u0440\u0435\u0430\u0433\u0435\u043D\u0442\u0430: 1.8 \u0433"
    DescriptionEnglish: 
    Warning: 
    WarningEnglish: 
    SafetyPrecautions: "\u2022\t\u041B\u043E\u0436\u0435\u0447\u043A\u0438 \u0438
      \u0448\u043F\u0430\u0442\u0435\u043B\u0438 \u0434\u043E\u043B\u0436\u043D\u044B
      \u0431\u044B\u0442\u044C \u0441\u0443\u0445\u0438\u043C\u0438 \u0438 \u0447\u0438\u0441\u0442\u044B\u043C\u0438
      \\n\u2022\t\u041D\u0435\u043B\u044C\u0437\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0448\u043F\u0430\u0442\u0435\u043B\u044C \u0434\u043B\u044F \u043E\u0442\u0431\u043E\u0440\u0430
      \u0432\u0435\u0449\u0435\u0441\u0442\u0432, \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445
      \u0441 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u043C \u0448\u043F\u0430\u0442\u0435\u043B\u044F
      \n\u2022\t\u041D\u0435\u0438\u0437\u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432\u0430\u043D\u043D\u044B\u0435
      \u0440\u0435\u0430\u043A\u0442\u0438\u0432\u044B \u043D\u0435\u043B\u044C\u0437\u044F
      \u0432\u044B\u043B\u0438\u0432\u0430\u0442\u044C \u0438\u043B\u0438 \u0432\u044B\u0441\u044B\u043F\u0430\u0442\u044C
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0432 \u0442\u0443 \u043F\u043E\u0441\u0443\u0434\u0443,
      \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043E\u043D\u0438
      \u0431\u044B\u043B\u0438 \u0432\u0437\u044F\u0442\u044B. \u0421\u043B\u0435\u0434\u0443\u0435\u0442
      \u043F\u043E\u043C\u0435\u0449\u0430\u0442\u044C \u0438\u0445 (\u043F\u043E
      \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u044E \u043F\u0440\u0435\u043F\u043E\u0434\u0430\u0432\u0430\u0442\u0435\u043B\u044F)
      \u0432 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u0441\u043A\u043B\u044F\u043D\u043A\u0438-\u0441\u0431\u043E\u0440\u043D\u0438\u043A\u0438
      \u0438\u043B\u0438 \u043C\u0443\u0441\u043E\u0440\u043D\u0438\u0446\u044B. 
      \n\u0415\u0441\u043B\u0438 \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u044F
      \u043E \u0434\u043E\u0437\u0438\u0440\u043E\u0432\u043A\u0435 \u0440\u0435\u0430\u043A\u0442\u0438\u0432\u043E\u0432
      \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0442, \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u0431\u0440\u0430\u0442\u044C \u0440\u0435\u0430\u043A\u0442\u0438\u0432\u044B,
      \u043F\u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438,
      \u0432 \u043C\u0435\u043D\u044C\u0448\u0435\u043C \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435 "
