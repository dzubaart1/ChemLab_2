  LabTask:
    Lab: 2
    Number: 89
    Title: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435 89"
    TitleEnglish: 
    Description: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435  \xAB\u0411\u0410\u041A\u0422\u0415\u0420\u0418\u0426\u0418\u0414\u041D\u0410\u042F
      \u041E\u0427\u0418\u0421\u0422\u041A\u0410\xBB "
    DescriptionEnglish: 
    Warning: "\u0411\u0430\u043A\u0442\u0435\u0440\u0438\u0446\u0438\u0434\u043D\u0430\u044F
      \u043E\u0447\u0438\u0441\u0442\u043A\u0430 \u2014 \u044D\u0442\u043E \u043F\u0440\u043E\u0446\u0435\u0441\u0441
      \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F \u0438\u043B\u0438 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u044F
      \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0439 \u043D\u0430 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044F\u0445 \u0438
      \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435 \u0441 \u0446\u0435\u043B\u044C\u044E
      \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
      \u0437\u0430\u0433\u0440\u044F\u0437\u043D\u0435\u043D\u0438\u044F \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u0432
      \u0438 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F \u0441\u0442\u0435\u0440\u0438\u043B\u044C\u043D\u044B\u0445
      \u0443\u0441\u043B\u043E\u0432\u0438\u0439 \u0434\u043B\u044F \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439.
      \u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u043E\u0431\u044B\u0447\u043D\u043E
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F \u0442\u0430\u043A\u0438\u0435
      \u043C\u0435\u0442\u043E\u0434\u044B, \u043A\u0430\u043A:\r\n\r\n\u2022\t\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
      \u0443\u043B\u044C\u0442\u0440\u0430\u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u0445
      \u043B\u0430\u043C\u043F \u0434\u043B\u044F \u0434\u0435\u0437\u0438\u043D\u0444\u0435\u043A\u0446\u0438\u0438
      \u0432\u043E\u0437\u0434\u0443\u0445\u0430 \u0438 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0435\u0439;\r\n\u2022\t\u0425\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0430, \u0432\u043A\u043B\u044E\u0447\u0430\u044E\u0449\u0430\u044F
      \u0434\u0435\u0437\u0438\u043D\u0444\u0438\u0446\u0438\u0440\u0443\u044E\u0449\u0438\u0435
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430;\r\n\u2022\t\u0424\u0438\u043B\u044C\u0442\u0440\u0430\u0446\u0438\u044F
      \u0432\u043E\u0437\u0434\u0443\u0445\u0430 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      HEPA-\u0444\u0438\u043B\u044C\u0442\u0440\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0443\u0434\u0430\u043B\u044F\u044E\u0442 \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0438
      \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043C\u0438\u043A\u0440\u043E\u0431\u044B.\r\n"
